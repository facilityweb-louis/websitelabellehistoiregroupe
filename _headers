# En-têtes — La Belle Histoire Groupe

# Sécurité sur toutes les pages
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=()

# Cache long pour les assets (images, fonts, JS, CSS)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# L'élément personnalisé <soleil-page> tourne sur le site Wix et lit ces
# fichiers en cross-origin : CORS doit donc être ouvert en lecture.
/soleil
  Access-Control-Allow-Origin: *

/soleil.html
  Access-Control-Allow-Origin: *

/soleil-element.js
  Access-Control-Allow-Origin: *

# Le moteur d'animation vit hors de /assets/ à dessein : ce dossier porte un
# cache d'un an marqué immutable, et Cloudflare Pages additionne les règles
# qui correspondent au lieu de laisser la plus précise l'emporter. Un script
# qui évolue ne peut donc pas y être corrigé.
/soleil-engine.js
  Access-Control-Allow-Origin: *

/assets/soleil/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable
