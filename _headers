# En-têtes — La Belle Histoire Groupe

# Sécurité sur toutes les pages
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=()

# Cache long pour les assets (images, fonts, JS, CSS)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# L'élément personnalisé <soleil-page> tourne sur le site Wix et lit ces
# fichiers en cross-origin : CORS doit donc être ouvert en lecture.
/soleil
  Access-Control-Allow-Origin: *

/soleil.html
  Access-Control-Allow-Origin: *

/soleil-element.js
  Access-Control-Allow-Origin: *

/assets/soleil/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable

# Le moteur d'animation, lui, évolue : s'il héritait du cache d'un an des
# images voisines, une correction ne parviendrait jamais aux visiteurs déjà
# venus. On le fait revalider à chaque visite.
/assets/soleil/soleil.js
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=0, must-revalidate
